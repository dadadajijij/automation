{
  "report_dir": "reports",
  "history_dir": "reports/history",
  "network": {
    "ping_targets": [
      "127.0.0.1",
      "8.8.8.8"
    ],
    "tcp_targets": [
      {
        "host": "1.1.1.1",
        "port": 53,
        "timeout_seconds": 2
      }
    ]
  },
  "mount_points": [
    "/"
  ],
  "service_checks": {
    "enabled": true,
    "project_ports_file": "../project-ports.json",
    "host_services": [
      {
        "name": "ka_tools",
        "display_name": "ka_tools",
        "type": "host",
        "host": "127.0.0.1",
        "port": 3000,
        "protocol": "http",
        "success_status_codes": [
          200,
          204,
          302,
          401
        ],
        "health_paths": [
          "/api/health",
          "/"
        ]
      }
    ],
    "container_services": {
      "exclude_names": [
        "ka-tools"
      ],
      "default_host": "127.0.0.1",
      "default_timeout_seconds": 3,
      "default_protocol": "auto",
      "default_health_paths": [
        "/api/health",
        "/health",
        "/"
      ],
      "base_path_templates": [
        "/tools2/{service_name}",
        "/tools2/{service_name}/"
      ],
      "default_success_status_codes": [
        200,
        204,
        301,
        302,
        307,
        308
      ],
      "per_service_overrides": {
        "audioqas": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/api/health",
            "/"
          ]
        },
        "agora-token-generator": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/api/health",
            "/"
          ]
        },
        "api-examples-web": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/",
            "/static-preview"
          ]
        },
        "agora-rest-api-debugger": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/tools2/agora-rest-api-debugger",
            "/tools2/agora-rest-api-debugger/",
            "/tools2/agora-rest-api-debugger/media-api"
          ]
        },
        "loga": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/",
            "/health"
          ]
        },
        "mos-video-compare": {
          "protocol": "http",
          "success_status_codes": [
            200,
            204
          ],
          "health_paths": [
            "/api/health",
            "/"
          ]
        },
        "decrypt-online": {
          "protocol": "tcp"
        }
      }
    }
  },
  "notifications": {
    "enabled": true,
    "wecom_webhook": ""
  },
  "thresholds": {
    "cpu_usage_percent": {
      "warning": 80,
      "critical": 90
    },
    "load_ratio": {
      "warning": 0.7,
      "critical": 1.0
    },
    "memory_usage_percent": {
      "warning": 80,
      "critical": 90
    },
    "swap_usage_percent": {
      "warning": 20,
      "critical": 50
    },
    "disk_usage_percent": {
      "warning": 80,
      "critical": 90
    },
    "inode_usage_percent": {
      "warning": 80,
      "critical": 90
    }
  }
}
