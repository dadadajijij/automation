HOST=0.0.0.0
PORT=8003
DATABASE_URL=./data/hermes_gateway.sqlite

# Point this at your Hermes binary.
# Example:
# HERMES_BIN=/home/devops/ka/automation/agent/hermes-agent/.venv/bin/hermes
HERMES_BIN=
CATEGORY_NAMES_FILE=/home/devops/ka/data/skills-manager/data/category_names.json
SKILL_NAMES_FILE=/home/devops/ka/data/skills-manager/data/skill_names.json
HERMES_WORKDIR=../hermes-agent
# Business traffic is fixed to Hermes' default profile.

# Optional shared gateway key.
GATEWAY_API_KEY=

# Admin login credentials for /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_COOKIE_NAME=hermes_admin_session
# Leave empty when the gateway is served from the domain root.
# Example: /tools2/hermes-gateway
PUBLIC_BASE_PATH=

# Optional per-request limits.
# The code fallback is 300; the current production deployment uses 1200.
HERMES_TIMEOUT_SECONDS=1200
HERMES_SOURCE_TAG=tool

# Attachment limits.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=30
ATTACHMENT_MAX_IMAGES=8
ATTACHMENT_REDIRECT_LIMIT=3
ATTACHMENT_STORAGE_ROOT=/tmp/hermes
ATTACHMENT_RETENTION_DAYS=3

# HTML reports generated by Hermes. Downloads use an opaque URL token, not a Gateway Key.
REPORT_SOURCE_ROOT=/home/devops/.hermes/cache/documents
REPORT_STORAGE_ROOT=./data/reports
# Full external Gateway base URL, including the reverse-proxy prefix exactly once.
REPORT_PUBLIC_BASE_URL=https://athena.agoralab.co/tools2/hermes-gateway
REPORT_RETENTION_DAYS=7
REPORT_MAX_BYTES=10485760
