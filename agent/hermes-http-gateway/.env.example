HOST=0.0.0.0
PORT=8011
DATABASE_URL=./data/hermes_gateway.sqlite

# Point this at your Hermes binary.
# Example:
# HERMES_BIN=/Users/panweikui/Pwk-Coding/automation/agent/hermes-agent/.venv/bin/hermes
HERMES_BIN=
HERMES_WORKDIR=/Users/panweikui/Pwk-Coding/automation/agent/hermes-agent
HERMES_PROFILE_DEFAULT=default

# Optional shared gateway key.
GATEWAY_API_KEY=

# Admin login credentials for /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=agora
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_COOKIE_NAME=hermes_admin_session
# Leave empty when the gateway is served from the domain root.
# Example: /tools2/hermes-gateway
PUBLIC_BASE_PATH=

# Optional per-request limits.
HERMES_TIMEOUT_SECONDS=300
HERMES_SOURCE_TAG=tool
